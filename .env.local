# ⚠️ WARNING: This file contains sensitive credentials. NEVER commit to git!
# If deployed to production, these credentials are compromised. Change them immediately!
# 
# URGENT ACTIONS REQUIRED:
# 1. Change MongoDB password in Atlas console
# 2. Generate new JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Change admin email and password
# 4. Update credentials in MongoDB Atlas, Vercel, and all deployment platforms

MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?appName=Cluster0
ADMIN_EMAIL=admin@thakshaka.com
ADMIN_PASSWORD=your-secure-password
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
JWT_SECRET=your-super-secret-jwt-key-generate-strong-random-value