# MongoDB Connection
# Get this from MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?appName=YourApp

# JWT Secret for Admin Authentication
# Generate a strong random secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-generate-a-strong-random-value

# Admin Credentials (change these in production immediately after first login)
ADMIN_EMAIL=admin@thakshaka.com
ADMIN_PASSWORD=your-secure-password-change-this

# Next.js Configuration
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rate Limiting Configuration
# Window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window per IP
RATE_LIMIT_MAX_REQUESTS=5
